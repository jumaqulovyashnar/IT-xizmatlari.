# ========================================================
# IT XIZMATLARI PLATFORMASI — MUHIT O'ZGARUVCHILARI (.env)
# ========================================================

# Tizim muhiti (development / production / staging)
NODE_ENV=development
PORT=4000
APP_NAME="IT Xizmatlari Platformasi"
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL ma'lumotlar bazasi
DATABASE_URL=postgresql://it_admin:it_secret_pass@localhost:5432/it_services_db?schema=public
POSTGRES_USER=it_admin
POSTGRES_PASSWORD=it_secret_pass
POSTGRES_DB=it_services_db
POSTGRES_PORT=5432

# Redis Kesh va Navbatlar (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Xavfsizlik
JWT_SECRET=super_secret_jwt_key_change_in_production_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# S3 / MinIO Fayl Saqlash
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secret_password
MINIO_BUCKET_NAME=it-services-attachments

# To'lov Tizimlari (Payment Gateways)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
STRIPE_SECRET_KEY=

# Xabarnomalar (Telegram / Email)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@itxizmatlari.uz
